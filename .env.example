# ── Batwara environment configuration ──────────────────────────────────
# Copy this file to .env and fill in real values.

# App
APP_NAME=Batwara
APP_VERSION=1.0.0
DEBUG=false

# Security — CHANGE THIS in production (openssl rand -hex 32)
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
# Token lifetime in minutes (default 24h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database — SQLite for local dev:
DATABASE_URL=sqlite:///./batwara.db
# PostgreSQL for production (docker-compose uses this):
# DATABASE_URL=postgresql+psycopg2://batwara:batwara@db:5432/batwara

# CORS — comma-separated origins, or * for all
CORS_ORIGINS=*

# Rate limiting
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH=10/minute

# Currency
CURRENCY=PKR
